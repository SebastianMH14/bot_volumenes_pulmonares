# Copiar a .env y completar con valores reales. NUNCA commitear el .env real.

# ── Sunu ──────────────────────────────────────────────────
URL_NUBE=https://cemde.sunu.be
USUARIO=
PASSWORD=

# ── Instancia (aparece en el asunto del reporte) ──────────
SEDE_LOCAL=LAURELES
CONSULTORIO=22

# ── Carpeta estándar donde la terapeuta deja los PDF ─────
# Ruta absoluta en el equipo del consultorio. Si se deja vacía se usa ./bandeja
CARPETA_ENTRADA=C:\Volumenes

# Corridas que un informe puede quedar pendiente antes de pasar a errores/
MAX_INTENTOS=3
DEBUG_RETENTION_DAYS=14

# ── Email de reporte diario ──────────────────────────────
EMAIL_REMITENTE=
EMAIL_PASSWORD=
EMAIL_DESTINATARIOS=correo1@ejemplo.com,correo2@ejemplo.com
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# ── Selectores de la pestaña Volúmenes Pulmonares ────────
# PENDIENTE: confirmar con `python explorar_sunu.py <cedula>` y ajustar
SEL_TAB_VOLUMENES=a.link-tab[href='#tab-volumenes-pulmonares']
SEL_CONTENEDOR_VOLUMENES=#tab-volumenes-pulmonares
